<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <uie:Toolbar style="height: 48px; min-width: 300px; align-items: center; justify-content: center;">
        <ui:Label text="Circuit Board" display-tooltip-when-elided="true" style="-unity-text-align: middle-center; width: 100%; font-size: 14px; height: 50px;" />
        <ui:Label display-tooltip-when-elided="true" style="position: absolute; background-image: url(&apos;project://database/Assets/Package/VAT.Logic/Editor/Assets/Icons/circuit-board-icon.png?fileID=2800000&amp;guid=774bce99a6531494c987219d2b64a496&amp;type=3#circuit-board-icon&apos;); -unity-background-scale-mode: scale-to-fit; width: 50px; height: 50px; right: 0;" />
    </uie:Toolbar>
    <uie:Toolbar style="justify-content: space-around; margin-top: 10px;">
        <uie:ToolbarButton text="Create" display-tooltip-when-elided="true" name="CreateMode" style="width: 100%; -unity-text-align: upper-center; padding-left: 0; padding-right: 0;" />
        <uie:ToolbarButton text="Wiring&#10;" display-tooltip-when-elided="true" name="WiringMode" style="width: 100%; -unity-text-align: upper-center; padding-left: 0; padding-right: 0;" />
    </uie:Toolbar>
    <ui:Toggle label="Show Nodes" value="true" name="NodeToggle" style="margin-top: 10px;" />
    <ui:Toggle label="Show Ports" value="true" name="PortToggle" style="align-items: center;" />
    <ui:VisualElement name="CreateElement">
        <ui:GroupBox name="CreateGroup" style="background-color: rgb(43, 43, 43);">
            <uie:Toolbar style="height: auto;">
                <ui:Button display-tooltip-when-elided="true" name="NewNode" tooltip="Create New Node" style="width: 50px; height: 50px; background-image: url(&apos;project://database/Assets/Package/VAT.Logic/Editor/Assets/Icons/node-icon.png?fileID=2800000&amp;guid=a0b662be09c32a64fa1fd88f414821b4&amp;type=3#node-icon&apos;); margin-top: 5px; margin-bottom: 5px; margin-left: 5px; margin-right: 5px;" />
                <ui:Button display-tooltip-when-elided="true" name="NewPort" tooltip="Create New Port" style="width: 50px; height: 50px; background-image: url(&apos;project://database/Assets/Package/VAT.Logic/Editor/Assets/Icons/port-icon.png?fileID=2800000&amp;guid=f5d4ceb2a489daa428342208a51e394c&amp;type=3#port-icon&apos;); margin-top: 5px; margin-bottom: 5px; margin-left: 5px; margin-right: 5px;" />
            </uie:Toolbar>
        </ui:GroupBox>
    </ui:VisualElement>
    <ui:VisualElement name="WiringElement">
        <ui:GroupBox name="WiringGroup" style="background-color: rgb(43, 43, 43); background-image: none;">
            <uie:ObjectField label="Output Node" type="VAT.Logic.Node, VAT.Logic" name="SelectedNode" tooltip="The node that will output to the selected port." />
            <uie:ObjectField label="Receiver Port" type="VAT.Logic.Port, VAT.Logic" name="SelectedPort" tooltip="The port that will receive signal from the selected node." style="justify-content: center;" />
            <ui:Button text="Wire" display-tooltip-when-elided="true" name="WireButton" style="width: 50%; -unity-text-align: middle-center; translate: 50% 0; margin-top: 5px; margin-bottom: 5px;" />
        </ui:GroupBox>
    </ui:VisualElement>
</ui:UXML>
